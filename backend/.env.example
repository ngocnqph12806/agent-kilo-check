# Server
PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database
DATABASE_URL=jdbc:postgresql://postgres:5432/skillseed
DATABASE_USERNAME=skillseed
DATABASE_PASSWORD=skillseed_dev_password

# Redis
REDIS_URL=redis://:skillseed_dev_password@redis:6379

# JWT (MUST be ≥ 256 bits, change in prod)
JWT_SECRET=local_dev_secret_min_256_bits_long_enough_for_security_requirements_xyz

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# External services (Phase 1)
DAILY_API_KEY=dev_placeholder
RESEND_API_KEY=dev_placeholder
GOOGLE_CLIENT_ID=dev_placeholder

# =====================================================================
# PRODUCTION additions (T-M211) — set in Railway env vars, never commit.
# Reference: docs/DEPLOYMENT.md §1.1.
