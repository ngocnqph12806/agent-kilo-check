# Frontend env (NEXT_PUBLIC_* exposed to browser, others server-only)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (Phase 1; GOOGLE_CLIENT_ID is exposed because Google Identity Services runs in the browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
APPLE_SERVICE_ID=
APPLE_CLIENT_ID=

