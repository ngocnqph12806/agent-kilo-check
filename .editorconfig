# EditorConfig — SkillSeed
# https://editorconfig.org
# Đảm bảo mọi editor (VS Code, IntelliJ, Vim, …) dùng style thống nhất.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = unset

[*.{ts,tsx,js,jsx}]
indent_size = 2
max_line_length = 100

[*.{html,css,scss}]
indent_size = 2

[Makefile]
indent_style = tab

[*.mdx]
indent_size = 2

[*.sql]
indent_size = 2

[*.proto]
indent_size = 2
